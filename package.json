{
  "name": "clinician-resource-companion",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "validate:content": "tsx scripts/validate-content.ts",
    "guardrails": "bash scripts/guardrail-scan.sh",
    "check": "npm run guardrails && npm run validate:content && npm run typecheck && npm test",
    "gen:content": "tsx scripts/gen-content-index.ts",
    "prebuild": "tsx scripts/gen-content-index.ts && tsx scripts/copy-ort.ts",
    "predev": "tsx scripts/copy-ort.ts",
    "model:fetch": "tsx scripts/fetch-model.ts",
    "model:embed": "tsx scripts/build-lexicon-embeddings.ts",
    "model:check": "tsx scripts/fetch-model.ts --check && tsx scripts/copy-ort.ts --check && tsx scripts/build-lexicon-embeddings.ts --check"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@huggingface/transformers": "^4.3.2",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.16.1",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.81.0",
    "next": "^16.4.6",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.11",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vitest": "^5.1.2"
  }
}
