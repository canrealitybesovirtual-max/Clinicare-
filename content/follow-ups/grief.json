          {
            "questionId": "grief-loss",
            "answerIds": [
              "yes"
            ]
          }
        ],
        "conditionIds": [
          "prolonged-grief-disorder"
        ]
      },
      "discriminates": [
        "prolonged-grief-disorder",
        "major-depressive-disorder"
      ],
      "priority": 10
    },
    {
      "id": "grief-focus",
      "kind": "discriminate",
      "domain": "grief",
      "text": "Is the pain mostly longing for, or preoccupation with, the person who died, or a broader loss of pleasure and self-worth across life?",
      "why": "Grief centers on the person who died and the relationship, and self-worth is usually intact; a depressive picture spreads to everything, with loss of pleasure and harsh self-criticism. Both can be present, and each points to a different focus of care.",
      "options": [
        {
          "id": "longing",
          "label": "Mostly longing for or preoccupation with the person",
          "effects": {
            "addSymptomIds": [
              "grief-yearning"
            ]
          }
        },
        {
          "id": "broad",
          "label": "A broader loss of pleasure and self-worth",
          "effects": {
            "addSymptomIds": [
              "anhedonia",
              "worthlessness-guilt"
            ]
          }
        },
        {
          "id": "both",
          "label": "Both",
          "effects": {
            "addSymptomIds": [
              "anhedonia",
              "worthlessness-guilt",
              "grief-yearning"
            ]
          }
        },
        {
          "id": "unsure",
          "label": "Not sure yet",
          "keepOpen": true
        }
      ],
      "showWhen": {
        "answered": [
          {
            "questionId": "grief-loss",
            "answerIds": [
              "yes"
            ]
          }
