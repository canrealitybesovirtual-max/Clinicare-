{
  "id": "grief",
  "title": "Grief, loss and life stressors",
  "domain": "grief",
  "about": "Questions that keep expected grief from being read as a disorder: whether someone close died, how long ago, whether the pain centers on the person who died or spreads across all of life, and whether symptoms followed a clear life stressor.",
  "questions": [
    {
      "id": "grief-loss",
      "kind": "discriminate",
      "domain": "grief",
      "text": "Has someone close to the client died?",
      "why": "Grief can look like depression. Knowing about a death, when it happened, and the client's cultural and faith practices around mourning helps avoid treating expected grief as a disorder.",
      "options": [
        {
          "id": "yes",
          "label": "Yes",
          "effects": {
            "addSymptomIds": [
              "bereavement"
            ]
          }
        },
        {
          "id": "no",
          "label": "No",
          "effects": {}
        },
        {
          "id": "unsure",
          "label": "Not asked yet",
          "keepOpen": true
        }
      ],
      "showWhen": {
        "symptomIds": [
          "depressed-mood",
          "anhedonia",
          "emotional-numbing-detachment",
          "social-withdrawal"
        ],
        "conditionIds": [
          "major-depressive-disorder",
          "prolonged-grief-disorder",
          "persistent-depressive-disorder"
        ]
      },
      "discriminates": [
        "major-depressive-disorder",
        "prolonged-grief-disorder"
      ],
      "priority": 30
    },
    {
      "id": "grief-time-since",
      "kind": "discriminate",
      "domain": "grief",
      "group": "duration",
      "text": "How long ago did the death happen?",
      "why": "Intense grief in the first months is expected and shaped by culture and faith. A prolonged grief pattern is considered only when grief stays intense and impairing well beyond that (about 6 months in ICD-11; about 12 months for adults in DSM-5-TR, see DSM-5-TR) and beyond what the client's community would expect.",
      "options": [
        {
          "id": "lt2w",
          "label": "Under 2 weeks",
          "effects": {
            "setDuration": "lt2w"
          }
        },
        {
          "id": "2to4w",
          "label": "2 to 4 weeks",
          "effects": {
            "setDuration": "2to4w"
          }
        },
        {
          "id": "1to6m",
          "label": "1 to 6 months",
          "effects": {
            "setDuration": "1to6m"
          }
        },
        {
          "id": "6to12m",
          "label": "6 to 12 months",
          "effects": {
            "setDuration": "gte6m"
          }
        },
        {
          "id": "gt12m",
          "label": "More than 12 months",
          "effects": {
            "setDuration": "gte6m"
          }
        },
        {
          "id": "unsure",
          "label": "Not sure yet",
          "keepOpen": true
        }
      ],
      "showWhen": {
