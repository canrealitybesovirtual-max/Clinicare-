    {
      "id": "adjustment-stressor",
      "kind": "discriminate",
      "domain": "grief",
      "text": "Did the symptoms start within a few months of a clear life stressor, such as a breakup, job loss, a move, an illness or money trouble?",
      "why": "Distress that follows a clear stressor and centers on it can be an adjustment reaction, especially when it does not fill out another pattern; it usually eases as the person adapts or the stressor ends. Problem-solving and support often fit well.",
      "options": [
        {
          "id": "yes",
          "label": "Yes: after a clear stressor",
          "effects": {
