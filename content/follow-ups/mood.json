{
  "id": "mood",
  "title": "Low mood: key features, course and mood elevation",
  "domain": "mood",
  "about": "Low mood, loss of interest, the course of a depressed mood, and the bipolar and borderline questions that change the picture: past high stretches, how far they went, how ups and downs run over time, and how close relationships go.",
  "questions": [
    {
      "id": "mood-interest",
      "kind": "core",
      "domain": "mood",
      "text": "Has the client lost interest or pleasure in things they usually enjoy (hobbies, food, company, sex)?",
      "why": "Loss of interest or pleasure is one of the two key features of a depressive episode, alongside low mood. Knowing whether it is present changes how much weight the rest of the picture carries.",
      "options": [
        {
          "id": "yes",
          "label": "Yes",
          "effects": {
            "addSymptomIds": [
              "anhedonia"
            ]
          }
        },
        {
          "id": "no",
          "label": "No: still enjoys things",
          "effects": {
            "negateSymptomIds": [
              "anhedonia"
            ]
          }
        },
        {
          "id": "unsure",
          "label": "Not sure yet",
          "keepOpen": true
        }
      ],
      "showWhen": {
        "symptomIds": [
          "depressed-mood",
          "worthlessness-guilt",
          "social-withdrawal",
          "fatigue",
          "emotional-numbing-detachment"
        ],
        "conditionIds": [
          "major-depressive-disorder",
          "persistent-depressive-disorder"
        ]
      },
      "targets": [
        "anhedonia"
      ],
      "discriminates": [
        "major-depressive-disorder",
        "persistent-depressive-disorder",
        "prolonged-grief-disorder"
      ],
      "priority": 10
    },
    {
      "id": "mood-low-most-days",
      "kind": "core",
      "domain": "mood",
      "text": "Has the client's mood been low, empty or heavy through long stretches of the day, and on the majority of days lately?",
      "why": "Persistent low mood is the other key feature of a depressive episode. Mood that lifts readily with good news, or dips only around one stressor, points elsewhere.",
      "options": [
        {
          "id": "yes",
          "label": "Yes",
          "effects": {
            "addSymptomIds": [
              "depressed-mood"
            ]
          }
        },
        {
          "id": "no",
          "label": "No",
          "effects": {
            "negateSymptomIds": [
              "depressed-mood"
            ]
          }
        },
        {
          "id": "unsure",
          "label": "Not sure yet",
          "keepOpen": true
        }
      ],
      "showWhen": {
        "symptomIds": [
          "anhedonia",
          "worthlessness-guilt",
          "social-withdrawal"
        ],
        "conditionIds": [
          "major-depressive-disorder",
          "persistent-depressive-disorder"
        ]
      },
      "targets": [
        "depressed-mood"
      ],
      "discriminates": [
        "major-depressive-disorder",
        "persistent-depressive-disorder"
      ],
      "priority": 10
    },
    {
      "id": "mood-course",
      "kind": "discriminate",
      "domain": "mood",
      "gate": "duration",
      "group": "duration",
      "text": "How long has the low mood been around: a recent stretch of weeks or months, or most days for years?",
      "why": "A recent episode of at least about two weeks fits a depressive episode; low mood on most days for two years or more points toward persistent depression; a few days of low mood after a setback is usually an ordinary reaction.",
      "options": [
        {
          "id": "lt2w",
          "label": "Under 2 weeks",
          "effects": {
            "setDuration": "lt2w"
          }
        },
        {
          "id": "2to4w",
          "label": "2 to 4 weeks",
          "effects": {
            "setDuration": "2to4w"
          }
        },
        {
          "id": "1to6m",
          "label": "1 to 6 months",
          "effects": {
            "setDuration": "1to6m"
          }
        },
        {
          "id": "6m-to-2y",
          "label": "6 months to 2 years",
          "effects": {
            "setDuration": "gte6m"
          }
        },
        {
          "id": "years",
          "label": "Most days for 2 years or longer",
          "effects": {
            "setDuration": "gte6m",
            "addSymptomIds": [
              "longstanding-low-mood"
            ]
          }
        },
        {
          "id": "unsure",
          "label": "Not sure yet",
          "keepOpen": true
        }
      ],
      "showWhen": {
        "symptomIds": [
          "depressed-mood",
          "anhedonia"
        ],
        "conditionIds": [
          "major-depressive-disorder",
          "persistent-depressive-disorder"
        ]
      },
      "discriminates": [
        "major-depressive-disorder",
        "persistent-depressive-disorder",
        "adjustment-disorder"
      ],
      "priority": 20
    },
    {
      "id": "mood-years",
      "kind": "discriminate",
      "domain": "mood",
      "text": "Looking back, has low mood been part of most days for two years or more, with only short breaks?",
      "why": "Long-standing low mood with only brief breaks points toward persistent depression, which can also carry a depressive episode on top. It changes expectations about pace and the value of longer-term support.",
      "options": [
        {
          "id": "yes",
          "label": "Yes: most days for two years or more",
          "effects": {
            "setDuration": "gte6m",
            "addSymptomIds": [
              "longstanding-low-mood"
            ]
          }
        },
        {
          "id": "no",
          "label": "No: this is a more recent change",
          "effects": {}
        },
        {
          "id": "unsure",
          "label": "Not sure yet",
          "keepOpen": true
        }
      ],
      "showWhen": {
        "answered": [
          {
            "questionId": "gate-duration",
            "answerIds": [
              "gte6m"
            ]
          },
          {
            "questionId": "mood-course",
            "answerIds": [
              "6m-to-2y"
            ]
          }
        ],
        "conditionIds": [
          "persistent-depressive-disorder"
        ]
      },
      "alsoRequires": {
        "symptomIds": [
          "depressed-mood"
        ],
        "conditionIds": [
          "major-depressive-disorder",
          "persistent-depressive-disorder"
        ]
      },
      "discriminates": [
        "persistent-depressive-disorder",
        "major-depressive-disorder"
      ],
      "priority": 30
    },
    {
      "id": "mood-elevated-history",
      "kind": "discriminate",
      "domain": "mood",
      "text": "Has the client ever had a stretch of several days feeling unusually up, wired or extremely irritable, with far more energy, thoughts racing, and little need for sleep?",
      "why": "A past elevated episode changes the picture (bipolar spectrum) and the treatment plan, including medication choices. It also separates lifelong restlessness (ADHD) and fast, relationship-driven mood shifts from distinct high stretches. A 'yes' brings the bipolar patterns into view and calls for a psychiatric evaluation.",
      "options": [
        {
          "id": "yes",
          "label": "Yes",
          "effects": {
            "addSymptomIds": [
              "grandiosity-elevated-mood"
            ]
          },
          "surfaces": [
            "psychiatric-referral"
          ],
          "note": "Consider a psychiatric evaluation before antidepressant decisions; ask about family history of bipolar disorder."
        },
        {
          "id": "with-substances",
          "label": "Only while using substances or a medication",
          "effects": {
            "setSubstancePossible": "yes"
          },
          "note": "Substance- or medication-related elevation still matters for planning; review with the prescriber."
        },
        {
          "id": "no",
          "label": "No",
          "effects": {}
        },
        {
          "id": "unsure",
          "label": "Not sure yet",
          "keepOpen": true
        }
      ],
      "showWhen": {
        "symptomIds": [
          "depressed-mood",
          "anhedonia",
          "decreased-need-for-sleep",
          "mood-swings",
          "racing-thoughts",
          "increased-goal-activity"
        ],
        "conditionIds": [
          "major-depressive-disorder",
          "persistent-depressive-disorder",
          "adult-adhd",
          "borderline-personality-disorder"
        ]
      },
      "targets": [
        "grandiosity-elevated-mood"
      ],
      "discriminates": [
        "major-depressive-disorder",
        "persistent-depressive-disorder",
        "bipolar-ii-disorder",
        "adult-adhd",
        "borderline-personality-disorder"
      ],
      "priority": 15
    },
    {
      "id": "mood-high-features",
      "kind": "core",
      "domain": "mood",
      "select": "many",
      "text": "During the high or driven stretches, what else changes?",
      "why": "Racing thoughts and a burst of plans and activity, alongside little need for sleep, show how far a high stretch goes beyond a good mood. Ask what friends or family noticed, too; people often see these stretches more clearly than the client does.",
      "options": [
        {
          "id": "racing",
          "label": "Thoughts race or jump ahead faster than they can be said",
          "effects": {
            "addSymptomIds": [
              "racing-thoughts"
            ]
          }
        },
        {
          "id": "activity",
          "label": "Takes on far more plans, projects or activity than usual",
          "effects": {
            "addSymptomIds": [
              "increased-goal-activity"
            ]
          }
        },
        {
          "id": "neither",
          "label": "Neither of these",
          "effects": {
            "negateSymptomIds": [
              "racing-thoughts",
              "increased-goal-activity"
            ]
          },
          "exclusive": true
        },
        {
          "id": "not-yet",
          "label": "Not asked yet",
          "keepOpen": true,
          "exclusive": true
        }
      ],
      "showWhen": {
        "symptomIds": [
          "grandiosity-elevated-mood",
          "decreased-need-for-sleep",
          "mood-swings"
        ],
        "conditionIds": [
          "bipolar-i-disorder",
          "bipolar-ii-disorder",
          "cyclothymic-disorder"
        ]
      },
      "targets": [
        "racing-thoughts",
        "increased-goal-activity"
      ],
      "discriminates": [
        "bipolar-i-disorder",
        "bipolar-ii-disorder",
        "cyclothymic-disorder"
      ],
      "priority": 20
    },
    {
      "id": "mood-high-impact",
      "kind": "discriminate",
      "domain": "mood",
      "text": "How far did the most intense high stretch go?",
      "why": "A high that led to hospital care, police contact, a break with reality or a serious crisis points toward a full manic episode; a clear change that others noticed while daily life kept going points toward milder highs. Either way, medication planning needs a psychiatric view.",
      "options": [
        {
          "id": "severe",
          "label": "It led to hospital care, police or legal trouble, a break with reality, or a serious crisis",
          "effects": {
            "addSymptomIds": [
              "mania-severe-impact"
            ]
          },
          "surfaces": [
            "psychiatric-referral"
          ],
          "note": "Arrange a prompt psychiatric evaluation and ask about safety during highs (spending, driving, sexual risk)."
        },
        {
          "id": "noticed",
          "label": "Others noticed a clear change, but work and home kept going",
          "effects": {
            "negateSymptomIds": [
              "mania-severe-impact"
            ]
          }
        },
        {
          "id": "unsure",
          "label": "Not sure yet",
          "keepOpen": true
        }
      ],
      "showWhen": {
        "symptomIds": [
          "grandiosity-elevated-mood"
        ],
        "conditionIds": [
          "bipolar-i-disorder",
          "bipolar-ii-disorder"
        ]
      },
      "targets": [
        "mania-severe-impact"
      ],
      "discriminates": [
        "bipolar-i-disorder",
        "bipolar-ii-disorder",
        "cyclothymic-disorder"
      ],
      "priority": 15
    },
    {
      "id": "mood-swings-course",
      "kind": "discriminate",
      "domain": "mood",
      "text": "How do the ups and downs run over time?",
      "why": "Milder highs and lows that have come and gone for years fit a cyclothymic pattern. Distinct stretches of days or weeks point toward a bipolar pattern. Shifts within hours, often set off by something in a close relationship, point toward the questions about relationships and fear of being left.",
      "options": [
        {
          "id": "years",
          "label": "Milder highs and lows that have come and gone for years",
          "effects": {
            "addSymptomIds": [
              "longstanding-mood-cycling"
            ]
          }
        },
        {
          "id": "episodes",
          "label": "Distinct stretches of days or weeks that are clearly high or clearly low",
          "effects": {},
          "note": "Ask about the most recent high: how long it lasted, sleep, and what others noticed."
        },
        {
          "id": "hours",
          "label": "Shifts within hours, often after a conflict or a feared rejection",
          "effects": {},
          "note": "Ask about close relationships, fear of being left and how anger shows up."
        },
        {
          "id": "unsure",
          "label": "Not sure yet",
          "keepOpen": true
        }
      ],
      "showWhen": {
        "symptomIds": [
          "mood-swings"
        ],
        "conditionIds": [
          "cyclothymic-disorder",
          "bipolar-ii-disorder",
          "borderline-personality-disorder"
        ]
      },
      "targets": [
        "longstanding-mood-cycling"
      ],
      "discriminates": [
        "cyclothymic-disorder",
        "bipolar-ii-disorder",
        "borderline-personality-disorder"
      ],
      "priority": 18
    },
    {
      "id": "relationships-fear-of-being-left",
      "kind": "core",
      "domain": "mood",
      "select": "many",
      "text": "How do close relationships tend to go?",
      "why": "Relationships that swing between closeness and sharp disappointment, and a strong fear of being left, are central to a borderline pattern. Ask gently and with examples; the client may describe the other person rather than the pattern.",
      "options": [
        {
          "id": "swings",
          "label": "They swing between closeness and sharp disappointment, with frequent breakups and reunions",
          "effects": {
            "addSymptomIds": [
              "unstable-relationships"
            ]
          }
        },
        {
          "id": "fear-left",
          "label": "Strong fear of being left, with urgent efforts to keep people close",
          "effects": {
            "addSymptomIds": [
              "fear-of-abandonment"
            ]
          }
        },
        {
          "id": "neither",
          "label": "Neither of these",
          "effects": {
            "negateSymptomIds": [
              "unstable-relationships",
              "fear-of-abandonment"
            ]
          },
          "exclusive": true
        },
        {
          "id": "not-yet",
          "label": "Not asked yet",
          "keepOpen": true,
          "exclusive": true
        }
      ],
      "showWhen": {
        "symptomIds": [
          "unstable-relationships",
          "fear-of-abandonment",
          "chronic-emptiness",
          "identity-disturbance",
          "intense-anger"
        ],
        "conditionIds": [
          "borderline-personality-disorder"
        ]
      },
      "targets": [
        "unstable-relationships",
        "fear-of-abandonment"
      ],
      "discriminates": [
        "borderline-personality-disorder",
        "bipolar-ii-disorder",
        "cyclothymic-disorder"
      ],
      "priority": 20
    }
  ],
