          "low-body-weight",
          "compensatory-exercise-fasting"
        ],
        "conditionIds": [
          "anorexia-nervosa",
          "bulimia-nervosa"
        ]
      },
      "priority": 10
    },
    {
      "id": "eating-pattern",
      "kind": "discriminate",
      "domain": "eating",
      "select": "many",
      "text": "Which of these are part of the eating pattern?",
      "why": "Eating far less than the body needs, eating episodes with a sense of losing control, and making up for eating separate the main eating patterns. Ask plainly and without judgment; shame keeps much of this hidden.",
      "options": [
        {
          "id": "restricting",
          "label": "Eating much less than the body needs, with weight well below a healthy range or falling fast",
          "effects": {
            "addSymptomIds": [
              "low-body-weight"
            ]
          }
        },
        {
          "id": "binges",
          "label": "Episodes of eating far more than usual, with a sense of losing control",
          "effects": {
            "addSymptomIds": [
              "binge-eating-episodes"
            ]
          }
        },
        {
          "id": "compensating",
          "label": "Fasting, very hard exercise or skipped meals to make up for eating",
          "effects": {
            "addSymptomIds": [
              "compensatory-exercise-fasting"
            ]
          }
        },
        {
          "id": "purging",
          "label": "Making themselves sick, or using laxatives or water pills",
          "effects": {
            "addSymptomIds": [
              "purging-or-fainting"
            ]
          },
          "surfaces": [
            "medical-referral"
          ],
          "note": "Purging can upset body salts and heart rhythm: arrange a medical review."
        },
        {
          "id": "none",
          "label": "None of these",
          "effects": {
            "negateSymptomIds": [
              "low-body-weight",
              "binge-eating-episodes",
              "compensatory-exercise-fasting"
            ]
          },
          "exclusive": true
