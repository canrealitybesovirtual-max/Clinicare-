{
  "id": "eating",
  "title": "Eating and weight",
  "domain": "eating",
  "about": "Eating questions: the eating pattern (restriction, binge episodes, compensating), what follows an episode, how weight and shape weigh on self-worth, and body warning signs, which call for a medical review. Answers only record what the clinician chose.",
  "questions": [
    {
      "id": "eating-medical-signs",
      "kind": "safety",
      "domain": "eating",
      "select": "many",
      "text": "Has the client had any body warning signs: fainting, a racing or irregular heartbeat, chest pain, confusion, or very little eating for days?",
      "why": "Restriction, purging and very hard exercise can affect the heart and body salts before weight looks low. These signs call for a same-day medical review. The app records only what you choose and never estimates risk.",
      "options": [
        {
          "id": "faint-heart",
          "label": "Fainting, a racing or irregular heartbeat, chest pain or confusion",
          "effects": {
            "addSymptomIds": [
              "purging-or-fainting"
            ]
          },
          "surfaces": [
            "urgent-medical"
          ],
          "note": "Arrange a same-day medical review (heart rhythm and blood tests)."
        },
        {
          "id": "not-eating",
          "label": "Very little eating for days, or weight falling fast",
          "effects": {
            "addSymptomIds": [
              "severe-food-restriction"
            ]
          },
          "surfaces": [
            "medical-referral"
          ],
          "note": "Arrange a medical review soon, including weight, vital signs and blood tests."
        },
        {
          "id": "none",
          "label": "None of these",
          "effects": {},
          "exclusive": true
        },
        {
          "id": "not-yet",
          "label": "Not asked yet",
          "keepOpen": true,
          "exclusive": true
        }
      ],
