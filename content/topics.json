    { "id": "cannabis", "en": "cannabis", "es": "marihuana", "clientLabel": "Cannabis (marijuana)", "clientLabelEs": "Cannabis (marihuana)", "sud": true, "handoutIds": ["urge-surfing-log", "relapse-prevention-plan"], "pages": { "en": "https://medlineplus.gov/cannabis.html", "es": "https://medlineplus.gov/spanish/cannabis.html" }, "safetyNote": { "en": "If you take medicines from a doctor, talk with your doctor or pharmacist before you change how you use cannabis or stop a medicine.", "es": "Si toma medicamentos recetados, hable con su médico o farmacéutico antes de cambiar su forma de usar cannabis o de dejar un medicamento." } },
    { "id": "opioids", "en": "opioids", "es": "opioides", "clientLabel": "Opioids and overdose safety", "clientLabelEs": "Opioides y prevención de sobredosis", "sud": true, "handoutIds": ["overdose-safety", "urge-surfing-log", "relapse-prevention-plan"], "pages": { "en": "https://medlineplus.gov/opioidsandopioidusedisorderoud.html", "es": "https://medlineplus.gov/spanish/opioidsandopioidusedisorderoud.html" }, "safetyNote": { "en": "After a break from opioids, your body can't handle as much as before, and the amount you used to take can cause an overdose. If you do use, don't use alone, and keep naloxone close by. If someone may have overdosed, call 911.", "es": "Después de un tiempo sin opioides, su cuerpo no aguanta tanto como antes, y la cantidad que usaba antes puede causar una sobredosis. Si va a usar, no lo haga sin compañía, y tenga cerca naloxona. Si alguien pudo haber tenido una sobredosis, llame al 911." } },
    { "id": "stimulants", "en": "methamphetamine", "es": "metanfetamina", "clientLabel": "Meth and other stimulants", "clientLabelEs": "Metanfetamina y otros estimulantes", "sud": true, "handoutIds": ["urge-surfing-log", "relapse-prevention-plan"], "pages": { "en": "https://medlineplus.gov/methamphetamine.html", "es": "https://medlineplus.gov/spanish/methamphetamine.html" }, "safetyNote": { "en": "Drugs bought on the street can contain fentanyl. If you use, don't use alone, and keep naloxone close by. If you take medicines from a doctor, talk with your doctor before you stop one.", "es": "Las drogas compradas en la calle pueden contener fentanilo. Si va a usar, no lo haga sin compañía, y tenga cerca naloxona. Si toma medicamentos recetados, hable con su médico antes de dejar alguno." } },
